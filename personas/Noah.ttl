@prefix : <http://piirrite.univ-lyon1.fr/data#> .
@prefix pcv: <http://piirrite.univ-lyon1.fr/vocabulary#> .
@prefix piirrite: <http://piirrite.univ-lyon1.fr/ontology/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Noah a piirrite:UserProfile ;
    rdfs:label "Low-vision pedestrian" ;
    piirrite:hasRequirement [ rdfs:label "Keep away from tram tracks" ;
            piirrite:hasCondition [ a piirrite:ComposedCondition ;
                    piirrite:hasOperand [ a piirrite:AtomicCondition ;
                            piirrite:hasDistanceFactor [ a piirrite:DistanceFactor ;
                                    piirrite:distanceType "From bird's flight" ;
                                    piirrite:hasRequiredValue 30.0 ;
                                    piirrite:usesOperator piirrite:LESSER_THAN ] ;
                            piirrite:hasRequiredValue "yes"^^xsd:string ;
                            piirrite:hasTargetProperty pcv:D_TRAM ;
                            piirrite:usesOperator piirrite:EQUALS ] ;
                    piirrite:usesOperator piirrite:NOT ] ;
            piirrite:hasFlexibility [ piirrite:hasValue 0.4 ] ;
            piirrite:hasImportance [ piirrite:hasValue 0.7 ] ],
        [ rdfs:label "Tactile paving where possible" ;
            piirrite:hasCondition [ a piirrite:AtomicCondition ;
                    piirrite:hasRequiredValue "yes"^^xsd:string ;
                    piirrite:hasTargetProperty pcv:P_TactilePaving ;
                    piirrite:usesOperator piirrite:EQUALS ] ;
            piirrite:hasFlexibility [ piirrite:hasValue 0.6 ] ;
            piirrite:hasImportance [ piirrite:hasValue 0.5 ] ],
        [ rdfs:label "Well-lit paths" ;
            piirrite:hasCondition [ a piirrite:AtomicCondition ;
                    piirrite:hasRequiredValue "yes"^^xsd:string ;
                    piirrite:hasTargetProperty pcv:P_Lit ;
                    piirrite:usesOperator piirrite:EQUALS ] ;
            piirrite:hasFlexibility [ piirrite:hasValue 0.3 ] ;
            piirrite:hasImportance [ piirrite:hasValue 0.9 ] ],
        [ rdfs:label "Prefer step-free" ;
            piirrite:hasCondition [ a piirrite:AtomicCondition ;
                    piirrite:hasRequiredValue false ;
                    piirrite:hasTargetProperty pcv:D_STAIRS ;
                    piirrite:usesOperator piirrite:EQUALS ] ;
            piirrite:hasFlexibility [ piirrite:hasValue 0.6 ] ;
            piirrite:hasImportance [ piirrite:hasValue 0.4 ] ] ;
    rdfs:comment "sensory" .

